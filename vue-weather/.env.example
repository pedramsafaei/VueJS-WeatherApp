# OpenWeatherMap API Configuration
# Get your free API key from: https://openweathermap.org/api
VUE_APP_WEATHER_API_KEY=your_api_key_here
VITE_WEATHER_API_KEY=your_api_key_here

VUE_APP_WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
VITE_WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Application Configuration
VUE_APP_DEFAULT_CITY=London
VITE_DEFAULT_CITY=London

VUE_APP_CACHE_DURATION=300000
VITE_CACHE_DURATION=300000

# Feature Flags
VUE_APP_ENABLE_GEOLOCATION=true
VUE_APP_ENABLE_WEATHER_MAPS=true
VUE_APP_ENABLE_WEATHER_ALERTS=true
